NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy Supabase public anon-key name; current source reads PUBLISHABLE_KEY instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Server-only Supabase Admin API credential; sensitive and never use a NEXT_PUBLIC_ prefix.
# Required by the protected admin user directory and admin deposit operations.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy server-only alias accepted by existing admin routes; prefer SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_SECRET_KEY=
